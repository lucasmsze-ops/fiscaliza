# Copie para .env.local (ignorado pelo git) e preencha com os valores do projeto no Supabase:
# Project Settings → API (ou Data API / API Keys).
SUPABASE_URL=
# Chave secreta (sb_secret_… ou a antiga service_role). Só scripts e cron; nunca no navegador nem na Vercel pública.
SUPABASE_SECRET_KEY=
# Chave publicável (sb_publishable_… ou a antiga anon). Leitura; também vai para a Vercel.
SUPABASE_PUBLISHABLE_KEY=
# Origem dos dados do site: "supabase" ou vazio (lê data/*.json). Na Vercel: supabase.
FISCALIZA_DADOS=
